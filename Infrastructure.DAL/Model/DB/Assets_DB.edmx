          <EntitySet Name="view_AssetEventLog" EntityType="Self.view_AssetEventLog" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [view_AssetEventLog].[Code] AS [Code], 
    [view_AssetEventLog].[RequestHeaderCode] AS [RequestHeaderCode], 
